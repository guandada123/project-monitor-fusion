includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app/
    excludePaths:
        - tests/
    parallel:
        maximumNumberOfProcesses: 4
    # 质量清理(2026-08-19): 收敛 Larastan 推断局限 / Eloquent 魔法属性误报。
    #
    # 1) property.notFound: 以下 4 文件中的未定义属性均属 Laravel Eloquent 魔法属性
    #    (withCount 聚合列、访问器/模型动态属性 $kind/$permissions/$done/$total/
    #    $definition/$name/$key 等),非真实 bug,类比 bandit 良性噪声。
    #    保留该规则对其他文件生效以捕捉真实拼写错误。
    # 2) argument.unresolvableType: AggregateView.php:77 的 map() 闭包 —— Larastan 对
    #    Collection::map() 泛型签名 + (object) 返回类型的已知推断局限,代码运行正确。
    ignoreErrors:
        -
            identifier: property.notFound
            path: app/Livewire/AggregateView.php
        -
            identifier: property.notFound
            path: app/Livewire/MetricsManager.php
        -
            identifier: property.notFound
            path: app/Models/User.php
        -
            identifier: property.notFound
            path: app/Services/MetricCollector.php
        -
            message: '#::map\(\) contains unresolvable type#'
            path: app/Livewire/AggregateView.php
    tmpDir: storage/framework/cache/phpstan
