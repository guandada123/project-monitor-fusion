# ─── Project Monitor — 环境配置 ───
# 复制为 .env 后根据本地环境修改

APP_NAME="Project Monitor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://localhost:8000

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ─── 日志 ───
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── 数据库 (PostgreSQL 16) ───
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=project_monitor
DB_USERNAME=project_monitor
DB_PASSWORD=

# ─── 会话 ───
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── 广播 / 队列 ───
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ─── 缓存 ───
CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ─── Redis (可选) ───
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── 邮件 ───
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── 飞书推送 ───
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# FEISHU_DAILY_TIME=08:30
# FEISHU_PARTITION_TAG=[项目监控]

# ─── GitHub 同步 ───
# GITHUB_TOKEN=ghp_xxx
# GITHUB_ORG=my-org
# GITHUB_REPO=my-repo

# ─── Vite ───
VITE_APP_NAME="${APP_NAME}"

# ─── Docker 部署 ───
# NGINX_PORT=8000                # 宿主机映射端口
# DB_PASSWORD=secret              # PostgreSQL 密码 (默认: secret)
